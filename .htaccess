# .htaccess - caching and compression for static assets
# Place at the webroot (C:\xampp\htdocs\puta\.htaccess)

<IfModule mod_expires.c>
  ExpiresActive On
  # Default: 1 month
  ExpiresDefault "access plus 1 month"

  # Images (long cache)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Icons
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # CSS and JS
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Add Cache-Control header for browsers that don't respect Expires
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Enable gzip compression for text-based resources
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json application/xml
</IfModule>

# Small fallback: remove ETag to improve caching behavior in some environments
FileETag None
