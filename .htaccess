# .htaccess - caching and compression for static assets
# Place at the webroot (C:\xampp\htdocs\puta\.htaccess)

<IfModule mod_expires.c>
  ExpiresActive On
  # Default: 1 month
  ExpiresDefault "access plus 1 month"

  # Images (long cache)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Icons
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # CSS and JS
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Add Cache-Control header for browsers that don't respect Expires
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Enable gzip compression for text-based resources
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json application/xml
</IfModule>

# Small fallback: remove ETag to improve caching behavior in some environments
FileETag None

# ===== Security Hardening =====
# Disable directory listing to prevent source browsing
Options -Indexes

# Block access to sensitive files (environment, scripts, SQL dumps, docs)
<FilesMatch "^(\.env|composer\.json|composer\.lock|.*\.sql|.*\.ps1|.*\.sh|database_commands\.txt|README\.md|ATTENDANCE_TIME_RULES\.md|CONTRIBUTING\.md|SECURITY_GUIDE\.md|SYSTEM_KNOWLEDGE_BASE\.md)$">
  Require all denied
  Order allow,deny
  Deny from all
</FilesMatch>

# Block hidden files (dotfiles)
<FilesMatch "^\.">
  Require all denied
  Order allow,deny
  Deny from all
</FilesMatch>

# Prevent serving source maps or TypeScript
<FilesMatch "\.(map|ts)$">
  Require all denied
  Order allow,deny
  Deny from all
</FilesMatch>

# Security headers (fallback; PHP sets these too)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
  # Fallback CSP (app also sets via PHP)
  Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:;"
</IfModule>
