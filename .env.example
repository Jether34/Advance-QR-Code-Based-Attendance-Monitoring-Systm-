# Environment Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit the actual .env file to git (add to .gitignore)

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_system
DB_USER=root
DB_PASS=your_secure_password_here

# Ollama LLM API Configuration (for AI-powered features)
OLLAMA_API_URL=http://localhost:11434/api/generate

# Application Settings
APP_NAME="Hybrid QR Code Based Attendance System"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# Security Settings
SESSION_LIFETIME=3600
CSRF_TOKEN_NAME=csrf_token
PASSWORD_HASH_ALGO=PASSWORD_DEFAULT

# Server Configuration  
SERVER_IP=127.0.0.1
SERVER_PORT=80
SERVER_PROTOCOL=http

# File Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=pdf

# Security: Force HTTPS in production (set to 1 when SSL is configured)
FORCE_HTTPS=0

# Session Cookie Security (optional overrides, bootstrap.php sets these by default)
SESSION_SECURE=0
SESSION_HTTPONLY=1
SESSION_SAMESITE=Strict

# Development/Debugging (set to false in production)
ENABLE_LOGGING=true
DEBUG_MODE=false
CORS_ORIGINS=*

# Cache Settings
CACHE_ENABLED=false
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Backup Settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30